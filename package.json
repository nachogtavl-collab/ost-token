{
  "name": "ost-token",
  "version": "0.1.0",
  "description": "OST (Out-of-Space Token) \u2014 SPL Token-2022 Confidential Transfers Client",
  "scripts": {
    "build": "anchor build",
    "build:betting": "anchor build -p ost_betting",
    "test": "anchor test",
    "test:betting": "ts-mocha -p ./tsconfig.json -t 1000000 tests/ost-betting.ts",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:betting:devnet": "powershell -ExecutionPolicy Bypass -File ./deploy-betting-devnet.ps1",
    "deploy:localnet": "anchor deploy --provider.cluster localnet",
    "fund:treasury": "ts-node scripts/fund-faucet-treasury.ts",
    "fund:pool": "ts-node scripts/fund-pool.ts",
    "vault:check": "ts-node scripts/ensure-vault-funded.ts",
    "vault:refill": "ts-node scripts/ensure-vault-funded.ts --confirm",
    "metadata:ost": "ts-node scripts/create-ost-metaplex-metadata.ts",
    "metadata:mint": "ts-node scripts/create-mint-metadata.ts",
    "deploy:site": "npx wrangler pages deploy docs --project-name ost-token --branch master",
    "predeploy:site": "node scripts/fetch-prediction-market-snapshot.js",
    "deploy:ipfs": "node scripts/deploy-ipfs.mjs"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@pythnetwork/hermes-client": "^3.1.0",
    "@pythnetwork/pyth-solana-receiver": "^0.16.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.36-alpha",
    "@solana/spl-token": "^0.4.12",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "chai": "^4.4.0",
    "mocha": "^10.7.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.0"
  }
}
