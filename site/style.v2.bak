/* ================================================================== */
/*  OST — Global Design System v2                                    */
/*  Alive, interactive, space-inspired. For every intelligence.       */
/* ================================================================== */

/* ---------- VARIABLES ---------- */
:root {
  --bg:         #0b0e17;
  --bg-alt:     #10141f;
  --surface:    #161b2a;
  --border:     #1f2640;
  --text:       #e4e6ef;
  --text-muted: #8e92a8;
  --accent:     #6d9fff;
  --accent2:    #a78bfa;
  --warm:       #f5c468;
  --success:    #34d399;
  --danger:     #f87171;
  --font-sans:  'Inter', system-ui, -apple-system, sans-serif;
  --font-serif: 'Playfair Display', Georgia, serif;
  --max-w:      1120px;
  --radius:     12px;
  --radius-sm:  8px;
  --shadow:     0 4px 32px rgba(0,0,0,.45);
  --glow-accent: 0 0 20px rgba(109,159,255,.25);
  --glow-warm:   0 0 20px rgba(245,196,104,.2);
}

/* ---------- RESET ---------- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; scroll-padding-top: 72px; }
body {
  font-family: var(--font-sans);
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
a { color: var(--accent); text-decoration: none; transition: color .2s; }
a:hover { color: var(--warm); }
img { max-width: 100%; display: block; }
code { background: var(--bg-alt); padding: 2px 6px; border-radius: 4px; font-size: .9em; }

/* ---------- UTILITIES ---------- */
.container { max-width: var(--max-w); margin: 0 auto; padding: 0 24px; position: relative; }
.text-muted { color: var(--text-muted); }

.section { padding: 100px 0; position: relative; }
.section-alt { background: var(--bg-alt); }
.section-title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: 700;
  text-align: center;
  margin-bottom: 16px;
  color: #fff;
}
.section-subtitle {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 56px;
  color: var(--text-muted);
  font-size: 1.1rem;
}

/* Gradient text */
.gradient-text {
  background: linear-gradient(135deg, var(--accent), var(--accent2), var(--warm));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ---------- BUTTONS ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 28px;
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: transform .15s, box-shadow .2s, background .2s;
  position: relative;
  overflow: hidden;
}
.btn:hover { transform: translateY(-2px); }
.btn:active { transform: translateY(0); }

.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  color: #fff;
  box-shadow: 0 4px 20px rgba(109,159,255,.35);
}
.btn-primary:hover { box-shadow: 0 6px 28px rgba(109,159,255,.5); color: #fff; }

.btn-outline {
  background: transparent;
  color: var(--text);
  border: 1.5px solid var(--border);
}
.btn-outline:hover { border-color: var(--accent); color: var(--accent); }

.btn-glow::before {
  content: '';
  position: absolute;
  inset: -2px;
  border-radius: inherit;
  background: linear-gradient(135deg, var(--accent), var(--accent2), var(--warm));
  z-index: -1;
  opacity: 0;
  transition: opacity .3s;
}
.btn-glow:hover::before { opacity: .5; filter: blur(8px); }

.pay-icon { color: var(--warm); }

/* ---------- NAV ---------- */
#nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
  background: rgba(11,14,23,.8);
  border-bottom: 1px solid var(--border);
}
.nav-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  height: 64px;
  gap: 16px;
}
.logo {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  font-weight: 700;
  color: #fff !important;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}
.logo-icon { color: var(--accent); font-size: 1.5rem; }

.nav-links {
  display: flex;
  gap: 20px;
  flex: 1;
  justify-content: center;
  overflow-x: auto;
  scrollbar-width: none;
}
.nav-links::-webkit-scrollbar { display: none; }
.nav-links a {
  color: var(--text-muted);
  font-size: .85rem;
  font-weight: 500;
  white-space: nowrap;
  transition: color .2s;
}
.nav-links a:hover, .nav-links a.active { color: #fff; }

.nav-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

/* Language dropdown */
.lang-dropdown { position: relative; }
.lang-trigger {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 6px 14px;
  cursor: pointer;
  color: var(--text);
  font-size: .9rem;
  font-weight: 500;
  transition: border-color .2s;
  font-family: var(--font-sans);
}
.lang-trigger:hover { border-color: var(--accent); }
.lang-globe { font-size: 1.1rem; }
.lang-code { font-weight: 600; }

.lang-list {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 8px 0;
  box-shadow: var(--shadow);
  opacity: 0;
  pointer-events: none;
  transform: translateY(-8px);
  transition: opacity .2s, transform .2s;
  min-width: 160px;
  max-height: 320px;
  overflow-y: auto;
  z-index: 200;
}
.lang-list.open {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}
.lang-list a {
  display: block;
  padding: 8px 16px;
  color: var(--text-muted);
  font-size: .9rem;
  white-space: nowrap;
  transition: background .15s;
}
.lang-list a:hover { background: var(--bg); color: #fff; }
.lang-list a.active { color: var(--accent); }

.nav-toggle {
  display: none;
  background: none;
  border: none;
  color: var(--text);
  font-size: 1.5rem;
  cursor: pointer;
}

/* ---------- HERO ---------- */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  padding-top: 80px;
  background: var(--bg);
}
#globeCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.hero-particles {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}
.hero-content {
  position: relative;
  z-index: 2;
  max-width: 760px;
  padding: 0 24px;
}
.hero-tag {
  display: inline-block;
  font-size: .85rem;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--warm);
  margin-bottom: 20px;
  animation: fadeInUp .8s ease;
}
.hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 7vw, 4.2rem);
  font-weight: 700;
  line-height: 1.15;
  color: #fff;
  margin-bottom: 24px;
  animation: fadeInUp .8s ease .1s both;
}
.hero-sub {
  font-size: 1.2rem;
  color: var(--text-muted);
  max-width: 600px;
  margin: 0 auto 36px;
  animation: fadeInUp .8s ease .2s both;
}
.hero-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 32px;
  animation: fadeInUp .8s ease .3s both;
}
.hero-tagline {
  font-size: .9rem;
  color: var(--text-muted);
  opacity: .7;
  line-height: 1.8;
  animation: fadeInUp .8s ease .4s both;
}

/* Hero stats */
.hero-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  margin-top: 48px;
  animation: fadeInUp .8s ease .5s both;
}
.stat { text-align: center; }
.stat-num {
  display: block;
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--accent);
  font-family: var(--font-serif);
}
.stat-label {
  display: block;
  font-size: .75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 4px;
}
.stat-divider {
  width: 1px;
  height: 40px;
  background: var(--border);
}

/* Scroll hint */
.scroll-hint {
  position: absolute;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  animation: bob 2s ease-in-out infinite;
}
.scroll-mouse {
  width: 24px;
  height: 40px;
  border: 2px solid var(--text-muted);
  border-radius: 12px;
  position: relative;
}
.scroll-dot {
  width: 4px;
  height: 8px;
  background: var(--accent);
  border-radius: 2px;
  position: absolute;
  top: 8px;
  left: 50%;
  transform: translateX(-50%);
  animation: scrollDot 2s ease-in-out infinite;
}
@keyframes scrollDot {
  0%, 100% { top: 8px; opacity: 1; }
  50%      { top: 22px; opacity: .3; }
}
@keyframes bob {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%      { transform: translateX(-50%) translateY(8px); }
}
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---------- FLOATING DECORATIONS ---------- */
.section-decor { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.float-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  animation: floatOrb 12s ease-in-out infinite;
}
.float-orb-1 {
  width: 300px; height: 300px;
  background: rgba(109,159,255,.08);
  top: 10%; left: -5%;
}
.float-orb-2 {
  width: 200px; height: 200px;
  background: rgba(167,139,250,.06);
  bottom: 15%; right: -3%;
  animation-delay: -6s;
}
@keyframes floatOrb {
  0%, 100% { transform: translate(0, 0); }
  33%  { transform: translate(30px, -20px); }
  66%  { transform: translate(-15px, 15px); }
}

/* ---------- MANIFESTO ---------- */
.manifesto {
  max-width: 720px;
  margin: 0 auto;
  font-size: 1.12rem;
  line-height: 1.85;
}
.manifesto p { margin-bottom: 24px; color: var(--text); }
.manifesto-lead {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 600;
  color: #fff !important;
  line-height: 1.5;
  border-left: 3px solid var(--warm);
  padding-left: 20px;
  margin-bottom: 32px !important;
}
.manifesto-closing {
  text-align: center;
  font-size: 1.15rem;
  color: var(--text-muted) !important;
  margin-top: 40px;
}

/* ---------- CITIZEN GRID (Cultural Cards) ---------- */
.citizen-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 24px;
}
.citizen-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 0 28px 28px;
  transition: transform .3s, box-shadow .3s, border-color .3s;
  overflow: hidden;
  position: relative;
}
.citizen-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow);
  border-color: rgba(109,159,255,.3);
}

/* Cultural color bars */
.culture-bar {
  height: 4px;
  margin: 0 -28px 20px;
  border-radius: 0;
}
.culture-china .culture-bar    { background: linear-gradient(90deg, #de2910, #ffde00); }
.culture-india .culture-bar    { background: linear-gradient(90deg, #ff9933, #fff, #138808); }
.culture-nigeria .culture-bar  { background: linear-gradient(90deg, #008751, #fff, #008751); }
.culture-brazil .culture-bar   { background: linear-gradient(90deg, #009739, #fedd00, #002776); }
.culture-mexico .culture-bar   { background: linear-gradient(90deg, #006847, #fff, #ce1126); }
.culture-russia .culture-bar   { background: linear-gradient(90deg, #fff, #0039a6, #d52b1e); }
.culture-iran .culture-bar     { background: linear-gradient(90deg, #239f40, #fff, #da0000); }
.culture-indonesia .culture-bar{ background: linear-gradient(90deg, #ff0000, #fff); }
.culture-turkey .culture-bar   { background: linear-gradient(90deg, #e30a17, #fff, #e30a17); }
.culture-egypt .culture-bar    { background: linear-gradient(90deg, #ce1126, #fff, #000); }
.culture-japan .culture-bar    { background: linear-gradient(90deg, #fff, #bc002d, #fff); }
.culture-kenya .culture-bar    { background: linear-gradient(90deg, #000, #bb0000, #006600); }

.citizen-flag {
  font-size: 3rem;
  margin-bottom: 8px;
  filter: drop-shadow(0 4px 12px rgba(0,0,0,.3));
}
.citizen-card h3 {
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 4px;
  color: #fff;
}
.culture-tagline {
  font-size: .85rem;
  color: var(--accent);
  font-weight: 500;
  margin-bottom: 12px !important;
  font-style: italic;
}
.citizen-card p {
  color: var(--text-muted);
  font-size: .95rem;
  line-height: 1.7;
}
.culture-symbols {
  margin-top: 16px;
  font-size: 1.4rem;
  letter-spacing: 8px;
  opacity: .7;
}

/* ---------- FEATURES GRID ---------- */
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 28px;
  margin-bottom: 64px;
}
.feature-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px 30px;
  transition: transform .3s, border-color .3s, box-shadow .3s;
}
.feature-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
}
.feature-icon { font-size: 2rem; margin-bottom: 16px; }
.feature-card h3 {
  font-size: 1.15rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 10px;
}
.feature-card p {
  color: var(--text-muted);
  font-size: .95rem;
  line-height: 1.7;
}

/* Glow card effect */
.glow-card {
  position: relative;
}
.glow-card::after {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  opacity: 0;
  z-index: -1;
  transition: opacity .3s;
  filter: blur(12px);
}
.glow-card:hover::after { opacity: .15; }

/* ---------- PAY DEMO (Mini Store) ---------- */
.pay-demo {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 48px 40px;
  max-width: 800px;
  margin: 0 auto;
  position: relative;
  overflow: hidden;
}
.pay-demo h3 {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  color: #fff;
  text-align: center;
  margin-bottom: 8px;
}
.pay-demo-sub {
  text-align: center;
  color: var(--text-muted);
  margin-bottom: 32px;
}

/* Store products */
.store-products {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 12px;
  margin-bottom: 24px;
}
.store-item {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  transition: border-color .2s, transform .15s;
}
.store-item:hover { border-color: var(--accent); transform: scale(1.02); }
.item-visual { font-size: 1.8rem; flex-shrink: 0; }
.item-details {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.item-name {
  font-weight: 600;
  color: #fff;
  font-size: .85rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.item-price {
  color: var(--warm);
  font-weight: 600;
  font-size: .8rem;
}
.btn-add {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1.5px solid var(--accent);
  background: transparent;
  color: var(--accent);
  font-size: 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background .15s, color .15s, transform .1s;
}
.btn-add:hover { background: var(--accent); color: #fff; }
.btn-add:active { transform: scale(.9); }
.btn-add.added {
  background: var(--success);
  border-color: var(--success);
  color: #fff;
}

/* Cart */
.store-cart {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 20px;
}
.cart-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
}
.cart-icon { font-size: 1.2rem; }
.cart-title {
  font-weight: 600;
  color: #fff;
  flex: 1;
}
.cart-badge {
  background: var(--accent);
  color: #fff;
  font-size: .75rem;
  font-weight: 700;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform .2s;
}
.cart-badge.bump { animation: cartBump .3s ease; }
@keyframes cartBump {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.3); }
}

.cart-items {
  min-height: 40px;
  margin-bottom: 16px;
}
.cart-empty {
  color: var(--text-muted);
  font-size: .9rem;
  text-align: center;
  padding: 8px 0;
}
.cart-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
  font-size: .9rem;
  border-bottom: 1px solid var(--border);
  animation: fadeInUp .3s ease;
}
.cart-line-name { color: var(--text); }
.cart-line-price { color: var(--warm); font-weight: 600; }
.cart-line-remove {
  background: none;
  border: none;
  color: var(--danger);
  cursor: pointer;
  font-size: .8rem;
  padding: 2px 6px;
  margin-left: 8px;
}

.cart-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.cart-total { display: flex; flex-direction: column; }
.cart-total span:first-child { font-size: .75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
.cart-total-amount { font-size: 1.3rem; font-weight: 700; color: #fff; }

.btn-pay { white-space: nowrap; }
.btn-pay:disabled { opacity: .4; cursor: not-allowed; transform: none !important; }

/* Payment overlay */
.pay-overlay {
  position: absolute;
  inset: 0;
  background: rgba(11,14,23,.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  opacity: 0;
  pointer-events: none;
  transition: opacity .4s;
  z-index: 10;
}
.pay-overlay.active { opacity: 1; pointer-events: auto; }

.pay-progress {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 32px;
}
.pay-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  opacity: .3;
  transition: opacity .4s;
}
.pay-step.active { opacity: 1; }
.pay-step.done { opacity: .7; }
.pay-step span { font-size: .75rem; color: var(--text-muted); white-space: nowrap; }
.step-ring {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  border: 2px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  transition: border-color .3s, box-shadow .3s;
}
.pay-step.active .step-ring {
  border-color: var(--accent);
  box-shadow: 0 0 20px rgba(109,159,255,.4);
  animation: pulseRing 1s ease-in-out infinite;
}
.pay-step.done .step-ring {
  border-color: var(--success);
}
@keyframes pulseRing {
  0%, 100% { box-shadow: 0 0 20px rgba(109,159,255,.4); }
  50%      { box-shadow: 0 0 30px rgba(109,159,255,.6); }
}

.pay-connector {
  width: 32px;
  height: 2px;
  background: var(--border);
  margin-bottom: 28px;
  position: relative;
}
.pay-connector::after {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 0;
  background: var(--accent);
  transition: width .5s ease;
}
.pay-connector.filled::after { width: 100%; }

.pay-receipt {
  text-align: center;
  opacity: 0;
  transform: translateY(16px);
  transition: opacity .5s, transform .5s;
}
.pay-receipt.show { opacity: 1; transform: translateY(0); }
.receipt-emoji { font-size: 3rem; margin-bottom: 12px; }
.receipt-text { font-size: 1.2rem; font-weight: 600; color: var(--success); margin-bottom: 4px; }
.receipt-sub { color: var(--text-muted); font-size: .9rem; }

/* ---------- TRANSFER WIDGET ---------- */
.transfer-widget {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 48px 40px;
  text-align: center;
  max-width: 700px;
  margin: 0 auto 48px;
}
.transfer-visual {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 24px;
  flex-wrap: wrap;
  position: relative;
}
.transfer-node {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 24px 20px;
  min-width: 180px;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  transition: border-color .3s;
}
.transfer-node:hover { border-color: var(--accent); }
.node-icon { font-size: 2rem; }
.node-label { font-weight: 600; color: #fff; font-size: .9rem; }
.node-result { color: var(--success); font-weight: 600; font-size: .85rem; }

.transfer-select, .transfer-amount {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: #fff;
  padding: 10px 14px;
  font-size: .9rem;
  width: 100%;
  font-family: var(--font-sans);
}
.transfer-select:focus, .transfer-amount:focus {
  outline: none;
  border-color: var(--accent);
}

.node-process {
  background: transparent;
  border: none;
  min-width: 140px;
  justify-content: center;
}
.process-steps { display: flex; flex-direction: column; gap: 12px; }
.process-step {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: .8rem;
  color: var(--text-muted);
  transition: color .3s;
}
.process-step.active { color: var(--accent); }
.process-step.done { color: var(--success); }
.process-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  border: 2px solid var(--border);
  flex-shrink: 0;
  transition: background .3s, border-color .3s;
}
.process-step.active .process-dot {
  background: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 0 8px rgba(109,159,255,.5);
}
.process-step.done .process-dot {
  background: var(--success);
  border-color: var(--success);
}

.transfer-note {
  color: var(--text-muted);
  font-size: .82rem;
  margin-top: 12px;
  opacity: .7;
}

/* ---------- FIAT RAMP ---------- */
.fiat-ramp {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px 32px;
  text-align: center;
  max-width: 700px;
  margin: 0 auto;
}
.fiat-ramp h3 {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  color: #fff;
  margin-bottom: 12px;
}
.fiat-ramp p {
  color: var(--text-muted);
  max-width: 640px;
  margin: 0 auto;
}

/* ---------- OFFLINE CARDS ---------- */
.offline-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 28px;
  margin-bottom: 48px;
}
.offline-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px 30px;
  text-align: center;
  transition: transform .3s, border-color .3s;
}
.offline-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
}
.offline-icon-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 20px;
}
.offline-icon { font-size: 2.5rem; position: relative; z-index: 1; }
.offline-pulse {
  position: absolute;
  inset: -12px;
  border-radius: 50%;
  border: 2px solid var(--accent);
  opacity: 0;
  animation: offlinePulse 2s ease-out infinite;
}
@keyframes offlinePulse {
  0%   { transform: scale(.8); opacity: .6; }
  100% { transform: scale(1.5); opacity: 0; }
}
.offline-card h3 { font-size: 1.15rem; font-weight: 600; color: #fff; margin-bottom: 10px; }
.offline-card p { color: var(--text-muted); font-size: .95rem; line-height: 1.7; }

/* ---------- GET OST — Jupiter, Fiats, Faucet ---------- */
.jupiter-widget {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 40px 32px;
  text-align: center;
  max-width: 600px;
  margin: 0 auto 48px;
}
.jupiter-widget h3 { font-family: var(--font-serif); font-size: 1.3rem; color: #fff; margin-bottom: 8px; }
.jupiter-widget p { color: var(--text-muted); margin-bottom: 24px; }
.jupiter-embed-area { margin-top: 20px; }
.jupiter-placeholder { padding: 24px; }
.jupiter-bolt {
  font-size: 2.5rem;
  display: block;
  margin-bottom: 16px;
  animation: flickerBolt 3s linear infinite;
}
@keyframes flickerBolt {
  0%, 90%, 100% { opacity: 1; }
  92%, 98% { opacity: .4; }
}

/* Fiat pills grid */
.fiat-section {
  max-width: 700px;
  margin: 0 auto 48px;
  text-align: center;
}
.fiat-heading {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  color: #fff;
  margin-bottom: 8px;
}
.fiat-sub { color: var(--text-muted); margin-bottom: 24px; font-size: .95rem; }
.fiat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
}
.fiat-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 24px;
  color: var(--text);
  font-size: .85rem;
  font-weight: 500;
  transition: border-color .2s, background .2s, transform .15s;
}
.fiat-pill:hover {
  border-color: var(--accent);
  background: var(--bg-alt);
  color: #fff;
  transform: translateY(-2px);
}
.fiat-pill span { font-size: 1.1rem; }

/* Animated Faucet */
.faucet-section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 48px 32px;
  text-align: center;
  max-width: 500px;
  margin: 0 auto;
}
.faucet-section h3 { font-family: var(--font-serif); font-size: 1.3rem; color: #fff; margin-bottom: 8px; }
.faucet-section > p { color: var(--text-muted); margin-bottom: 32px; }

.faucet-machine {
  position: relative;
  height: 200px;
  margin-bottom: 24px;
}
.faucet-pipe {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 60px;
  background: linear-gradient(180deg, var(--accent), var(--accent2));
  border-radius: 8px 8px 4px 4px;
}
.faucet-spout {
  position: absolute;
  bottom: -8px;
  left: 50%;
  transform: translateX(-50%);
  width: 16px;
  height: 16px;
  background: var(--accent2);
  border-radius: 50%;
}
.faucet-drop-zone {
  position: absolute;
  top: 68px;
  left: 50%;
  transform: translateX(-50%);
  width: 60px;
  height: 100px;
  pointer-events: none;
}
.faucet-coin {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  font-size: 1.5rem;
  animation: dropCoin 1s ease-in forwards;
  color: var(--warm);
  font-weight: 700;
  text-shadow: 0 0 12px rgba(245,196,104,.6);
}
@keyframes dropCoin {
  0%   { top: 0; opacity: 1; transform: translateX(-50%) scale(1); }
  70%  { opacity: 1; }
  100% { top: 90px; opacity: 0; transform: translateX(-50%) scale(.6); }
}

.faucet-pool {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
}
.faucet-amount {
  font-size: 2rem;
  font-weight: 700;
  color: var(--warm);
  font-family: var(--font-serif);
  transition: transform .3s;
}
.faucet-amount.bump { animation: cartBump .3s ease; }
.faucet-label { font-size: .75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }

.faucet-btn { margin-bottom: 16px; }
.faucet-status {
  min-height: 24px;
  font-size: .9rem;
  color: var(--text-muted);
}

/* Confetti */
.confetti {
  position: fixed;
  top: -20px;
  width: 10px;
  height: 10px;
  border-radius: 2px;
  z-index: 999;
  animation: confettiFall linear forwards;
  pointer-events: none;
}
@keyframes confettiFall {
  0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
}

/* ---------- AI SECTION ---------- */
.ai-hero-visual {
  display: flex;
  justify-content: center;
  margin-bottom: 48px;
}
.ai-orb {
  position: relative;
  width: 120px;
  height: 120px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ai-core {
  font-size: 3rem;
  position: relative;
  z-index: 1;
  animation: float 3s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10px); }
}
.ai-ring {
  position: absolute;
  inset: 0;
  border: 1px solid var(--accent);
  border-radius: 50%;
  opacity: .3;
  animation: aiSpin linear infinite;
}
.ai-ring-1 { animation-duration: 8s; inset: -10px; }
.ai-ring-2 { animation-duration: 12s; animation-direction: reverse; inset: -25px; border-color: var(--accent2); }
.ai-ring-3 { animation-duration: 16s; inset: -40px; border-color: var(--warm); opacity: .15; }
@keyframes aiSpin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* ---------- CREATORS SECTION ---------- */
.creators-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 28px;
  margin-bottom: 48px;
}
.creator-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px 30px;
  transition: transform .3s, border-color .3s;
}
.creator-card:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
}
.creator-icon { font-size: 2rem; margin-bottom: 16px; }
.creator-card h3 { font-size: 1.15rem; font-weight: 600; color: #fff; margin-bottom: 10px; }
.creator-card p { color: var(--text-muted); font-size: .95rem; line-height: 1.7; margin-bottom: 16px; }
.creator-tags { display: flex; gap: 8px; flex-wrap: wrap; }
.tag {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 4px 12px;
  border-radius: 16px;
  font-size: .75rem;
  color: var(--text-muted);
  font-weight: 500;
}

/* CTA Box */
.cta-box {
  background: linear-gradient(135deg, rgba(109,159,255,.08), rgba(167,139,250,.08));
  border: 1px solid rgba(109,159,255,.2);
  border-radius: var(--radius);
  padding: 48px 40px;
  text-align: center;
}
.cta-box h3 { font-family: var(--font-serif); font-size: 1.5rem; color: #fff; margin-bottom: 12px; }
.cta-box p { color: var(--text-muted); margin-bottom: 24px; }
.cta-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

/* ---------- VERIFY GRID ---------- */
.verify-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 28px;
}

/* ---------- FOOTER ---------- */
.footer {
  padding: 60px 0 40px;
  border-top: 1px solid var(--border);
}
.footer-space {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 48px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px;
  background: var(--surface);
}
.footer-space p { color: var(--text-muted); font-size: 1rem; line-height: 1.8; }
.footer-bottom { text-align: center; }
.footer-logo {
  font-family: var(--font-serif);
  font-size: 1.3rem;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12px;
}
.footer-copy {
  color: var(--text-muted);
  font-size: .9rem;
  margin-bottom: 20px;
  line-height: 1.7;
}
.footer-links { display: flex; gap: 24px; justify-content: center; }
.footer-links a { color: var(--text-muted); font-size: .9rem; }
.footer-links a:hover { color: var(--accent); }

/* ---------- BACKGROUND PARTICLES ---------- */
.bg-particles {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.bg-particle {
  position: absolute;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--accent);
  opacity: .08;
  animation: particleDrift linear infinite;
}
@keyframes particleDrift {
  0%   { transform: translateY(0) translateX(0); opacity: 0; }
  10%  { opacity: .08; }
  90%  { opacity: .08; }
  100% { transform: translateY(-100vh) translateX(40px); opacity: 0; }
}

/* ---------- SCROLL REVEAL ---------- */
.reveal-ready {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity .7s ease, transform .7s ease;
}
.revealed {
  opacity: 1 !important;
  transform: translateY(0) !important;
}

/* ---------- RESPONSIVE ---------- */
@media (max-width: 960px) {
  .nav-links { gap: 12px; }
  .nav-links a { font-size: .8rem; }
}

@media (max-width: 768px) {
  .nav-links {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 64px;
    left: 0; right: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 16px 24px;
    gap: 12px;
    z-index: 99;
  }
  .nav-links.open { display: flex; }
  .nav-toggle { display: block; }

  .hero h1 { font-size: 2.2rem; }
  .hero-sub { font-size: 1rem; }
  .hero-stats { gap: 16px; flex-wrap: wrap; }

  .section { padding: 64px 0; }

  .citizen-grid { grid-template-columns: 1fr; }
  .features-grid { grid-template-columns: 1fr; }
  .offline-grid { grid-template-columns: 1fr; }
  .creators-grid { grid-template-columns: 1fr; }
  .verify-grid { grid-template-columns: 1fr; }
  .store-products { grid-template-columns: 1fr; }

  .pay-demo { padding: 28px 20px; }
  .transfer-widget { padding: 28px 20px; }
  .transfer-visual { flex-direction: column; }
  .faucet-section { padding: 32px 20px; }
  .cta-box { padding: 32px 20px; }

  .pay-progress { flex-wrap: wrap; justify-content: center; }
  .pay-connector { display: none; }
}

@media (max-width: 480px) {
  .hero-actions { flex-direction: column; align-items: center; }
  .hero-actions .btn { width: 100%; justify-content: center; }
  .cta-actions { flex-direction: column; align-items: center; }
  .cta-actions .btn { width: 100%; justify-content: center; }
}
