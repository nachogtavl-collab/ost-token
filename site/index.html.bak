              <option>Bank / Card (USD)</option>
              <option>Bank / Card (EUR)</option>
              <option>Bank / Card (Other)</option>
            </select>
          </div>
          <div class="convert-arrow">→</div>
          <div class="convert-box">
            <span class="convert-label">You Get</span>
            <div class="convert-result">
              <span class="convert-ost">◉ OST</span>
              <span class="convert-note">Private &amp; Instant</span>
